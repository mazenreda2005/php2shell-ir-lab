# Copy to terraform.tfvars and adjust only if you want to override defaults.
# Everything here already has a sensible default in variables.tf.

# project_name  = "php2shell-lab"
# instance_type = "t3.micro"

# Leave allowed_cidr unset to auto-lock access to your current public IP.
# Set it explicitly if your IP changes often, e.g. a whole office range:
# allowed_cidr  = "203.0.113.0/24"

# The fleet. Default is 1 vulnerable + 2 healthy. Override to resize:
# fleet = {
#   "web-01" = { php_version = "8.2.20", status = "vulnerable" }
#   "web-02" = { php_version = "8.2.35", status = "healthy" }
#   "web-03" = { php_version = "8.2.35", status = "healthy" }
# }
